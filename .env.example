# MongoDB Atlas connection string (buat cluster gratis di https://www.mongodb.com/cloud/atlas)
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/artapedia

# Pakasir (https://pakasir.com) - untuk deposit otomatis QRIS
PAKASIR_PROJECT=slug-project-kamu
PAKASIR_APIKEY=api-key-pakasir-kamu

# WarungNokos (https://warungnokos.web.id) - 2 server nokos + QRIS deposit.
# Ambil API Key (format wn-...) di menu Profil.
# JANGAN ditulis di kode / di-commit ke GitHub.
WARUNGNOKOS_APIKEY=wn-xxxxxxxxxxxxxxxxxxxxxxxx
# Opsional: ganti base URL kalau WarungNokos memindahkan alamatnya.
WARUNGNOKOS_BASE_URL=

# dibanana (https://dibanana.id/api-docs) - server nokos "OTP Fast Murah"
# Buat key di Profile -> API Key. JANGAN ditulis di kode / di-commit ke GitHub.
DIBANANA_APIKEY=bn_live_xxxxxxxxxxxxxxxxxxxx

# RumahOTP (https://www.rumahotp.io) - untuk beli nomor OTP semua layanan
RUMAHOTP_APIKEY=rk-xxxxxxxxxxxxxxxxxxxxxxxx

# Batas nominal deposit (rupiah)
DEPOSIT_MIN_AMOUNT=2000
DEPOSIT_MAX_AMOUNT=1000000

# Markup harga OTP dalam persen, contoh 10 = harga RumahOTP + 10%. Boleh 0.
OTP_MARKUP_PERCENT=0

# Notifikasi Telegram (opsional) - dikirim ke channel/grup saat ada deposit pending,
# deposit sukses, dan pembelian nomor OTP/nokos. Kalau dua variabel di bawah
# dikosongkan, notifikasi otomatis nonaktif tanpa mengganggu transaksi.
# 1. Buat bot via @BotFather, ambil token-nya.
# 2. Tambahkan bot itu jadi admin di channel/grup tujuan.
# 3. Ambil chat_id channel (angka negatif untuk channel/grup, atau @username_channel kalau publik).
TELEGRAM_BOT_TOKEN=123456789:isi-token-bot-kamu
TELEGRAM_CHAT_ID=@nama_channel_kamu
# Link ads yang ditempel di setiap notifikasi ("mau beli nokos kuy")
TELEGRAM_ADS_LINK=https://t.me/isi_link_kamu_disini
TELEGRAM_ADS_TEXT=Mau beli nokos kuy? klik di sini

# --- Bot Telegram untuk OWNER (kontrol saldo & lihat user lewat chat) ---
# Pakai TELEGRAM_BOT_TOKEN yang sama dengan di atas (boleh bot yang sama atau bot baru).
# Isi dengan chat_id Telegram kamu sendiri (bisa lebih dari satu, pisahkan koma).
# Cara dapat chat_id: chat bot kamu lalu buka https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_OWNER_IDS=123456789
# Opsional tapi disarankan: string rahasia bebas untuk verifikasi webhook (lihat README).
TELEGRAM_WEBHOOK_SECRET=isi-string-acak-rahasia

# --- Program undang teman (referral) ---
# Persen bonus saldo yang didapat pengundang saat teman yang diundang deposit pertama kali.
# Contoh: 10 = pengundang dapat 10% dari nominal deposit pertama temannya. Isi 0 untuk nonaktif.
REFERRAL_BONUS_PERCENT=10

# --- Log aktivitas pengguna & monitoring layanan (terpisah dari notif transaksi di atas) ---
# Dikirim ke thread/topik Telegram khusus, defaultnya thread "2949" di grup
# https://t.me/diskusiduniotp (butuh TELEGRAM_BOT_TOKEN yang sudah diisi di atas,
# dan bot-nya harus jadi member/admin di grup tujuan). Kosongkan untuk pakai default.
TELEGRAM_MONITOR_CHAT_ID=@diskusiduniotp
TELEGRAM_MONITOR_THREAD_ID=2949

# --- Cron pembersihan otomatis MongoDB (tiap 5 menit, lihat vercel.json) ---
# String rahasia bebas untuk melindungi endpoint /api/cron/cleanup supaya tidak
# bisa dipicu sembarang orang dari luar. Kalau dikosongkan, endpoint terbuka publik
# (cuma aman untuk testing awal, WAJIB diisi kalau sudah live).
# PENTING: Vercel Cron di paket Hobby (gratis) minimal jadwalnya 1x/hari, BUKAN
# tiap 5 menit — vercel.json di project ini tetap diset "*/5 * * * *" untuk paket
# Pro ke atas. Kalau masih di paket Hobby, pakai cron eksternal gratis (mis.
# cron-job.org atau UptimeRobot) untuk memanggil URL berikut tiap 5 menit:
#   https://domain-kamu.vercel.app/api/cron/cleanup?secret=ISI_CRON_SECRET
CRON_SECRET=isi-string-acak-rahasia-lain

# URL website (dipakai tombol di notifikasi Telegram)
# Ganti dengan URL Netlify kamu, contoh: https://nama-site-kamu.netlify.app/
NEXT_PUBLIC_SITE_URL=https://nama-site-kamu.netlify.app/

# Kode masuk dashboard admin (WAJIB diganti, default-nya mudah ditebak)
ADMIN_CODE=ganti-dengan-kode-rahasia
