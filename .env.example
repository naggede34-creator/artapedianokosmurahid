# ════════════════════════════════════════════════════════════════════════════
# ARTAPEDIA — DAFTAR ENVIRONMENT VARIABLES (tinggal isi)
#
# VERCEL: Settings → Environment Variables → "Import .env" → tempel isi berkas
#         ini setelah kamu isi → Save → Redeploy.
#
# YANG WAJIB: hanya BAGIAN 1. Bagian 2 dst. BOLEH dikosongkan di sini dan diisi
# lewat web (/admin → Konfigurasi, terenkripsi, langsung berlaku tanpa deploy).
# Cukup isi di salah satu tempat. Kalau dua-duanya terisi, yang dari web dipakai.
# Baris berawalan # = opsional (hapus # kalau mau dipakai).
# JANGAN commit berkas yang sudah berisi nilai asli ke GitHub.
# ════════════════════════════════════════════════════════════════════════════

# ── BAGIAN 1 · WAJIB / INTI ─────────────────────────────────────────────────
# Alamat MongoDB Atlas (Network Access: izinkan 0.0.0.0/0 untuk Vercel)
MONGODB_URI=
# Alamat website tanpa garis miring di akhir, contoh https://nama.vercel.app
NEXT_PUBLIC_SITE_URL=
# Kode masuk /admin (pilih sendiri, panjang & acak)
ADMIN_CODE=
# Rahasia cron (string acak bebas). Pakai di URL /api/cron/tick?secret=ISI
CRON_SECRET=

# ── BAGIAN 2 · NOKOS & QRIS GATEWAY (boleh diisi lewat web saja) ───────────
# WarungNokos — API key format wn-...
WARUNGNOKOS_APIKEY=
# AustinPay — QRIS gateway + penarikan otomatis (IP server harus di-whitelist)
AUSTINPAY_APIKEY=
AUSTINPAY_APISECRET=
AUSTINPAY_WEBHOOK_SECRET=

# ── BAGIAN 3 · OPSIONAL (semua bisa diisi lewat /admin → Konfigurasi) ──────

# 🔐 Keamanan admin  
# Rahasia tanda tangan sesi (opsional) (rahasia)
# ADMIN_SECRET=
# 🚨 MODE BACA-SAJA DARURAT — hentikan semua transaksi uang
# MODE_BACA_SAJA=
# Keamanan otomatis: pemindaian berkala pola mencurigakan
# KEAMANAN_OTOMATIS=
# Keamanan otomatis: bekukan akun yang jelas melanggar
# KEAMANAN_SUSPEND_OTOMATIS=
# Keamanan: batas jumlah transfer saldo per akun per jam sebelum ditandai
# KEAMANAN_TRANSFER_MAKS_JAM=
# Keamanan: batas jumlah akun berbeda per perangkat/24 jam sebelum ditandai
# KEAMANAN_AKUN_PER_PERANGKAT=

# 📱 Penyedia nomor (OTP)  
# WarungNokos — API key khusus API baru (Server 2 / warkosv3), opsional (rahasia)
# WARUNGNOKOS_V3_APIKEY=
# WarungNokos — alamat API
# WARUNGNOKOS_BASE_URL=
# WarungNokos — pisahkan produk 'Server 1' dan 'Server 2'
# WARUNGNOKOS_PISAH_SERVER=

# 💳 Pembayaran QRIS  
# Pakasir — slug proyek
# PAKASIR_PROJECT=
# Pakasir — API key (rahasia)
# PAKASIR_APIKEY=
# Pakasir — merchant ID (untuk cek kesehatan)
# PAKASIR_MERCHANT_ID=
# Pakasir — alamat API
# PAKASIR_BASE_URL=
# Rute deposit otomatis (pembeli tidak memilih penyedia)
# DEPOSIT_RUTE_AKTIF=
# QRIS UTAMA — satu metode, penyedia diacak untuk SEMUA nominal
# DEPOSIT_UTAMA_AKTIF=
# QRIS UTAMA — daftar penyedia yang diacak (pisah koma)
# DEPOSIT_UTAMA_POOL=
# Pengingat QRIS hampir kedaluwarsa — berapa menit sebelum habis (0 = mati)
# DEPOSIT_PENGINGAT_MENIT=
# Rute deposit — batas nominal atas/bawah (Rp)
# DEPOSIT_RUTE_BATAS_RP=
# Rute deposit — nominal minimum saat rute nyala (Rp)
# DEPOSIT_RUTE_MIN_RP=
# Rute deposit — penyedia untuk nominal ≥ batas (diacak; pisah koma)
# DEPOSIT_RUTE_ATAS=
# Rute deposit — penyedia untuk nominal < batas (diacak; pisah koma)
# DEPOSIT_RUTE_BAWAH=
# AustinPay — alamat API
# AUSTINPAY_BASE_URL=
# AustinPay — proxy keluar (IP tetap, opsional) (rahasia)
# AUSTINPAY_PROXY=
# AustinPay — kabari admin bila saldo di bawah (Rp; 0 = mati)
# AUSTINPAY_SALDO_MIN=

# 🤖 Telegram & bot  
# Bot notifikasi admin — token (rahasia)
# TELEGRAM_BOT_TOKEN=
# Chat ID admin (tujuan notifikasi)
# TELEGRAM_CHAT_ID=
# Channel publik (ID atau @username)
# TELEGRAM_CHANNEL_ID=
# ID Telegram owner (boleh banyak, pisah koma)
# TELEGRAM_OWNER_IDS=
# Secret webhook bot notifikasi (rahasia)
# TELEGRAM_WEBHOOK_SECRET=
# Bot toko — token (rahasia)
# SHOP_BOT_TOKEN=
# Secret webhook bot toko (rahasia)
# SHOP_BOT_WEBHOOK_SECRET=
# ID owner bot toko (kosong = pakai owner notifikasi)
# SHOP_BOT_OWNER_IDS=
# Hashtag di bawah tiap kiriman channel
# CHANNEL_HASHTAG=
# Notif admin — tampilkan kode akun UTUH (1 = ya, 0 = samarkan, kosong = otomatis)
# NOTIF_TOKEN_PENUH=
# Chat pemantau cron
# TELEGRAM_MONITOR_CHAT_ID=
# Thread pemantau cron
# TELEGRAM_MONITOR_THREAD_ID=

# 🌐 Website  
# Kunci akun pengguna — masa tunggu buka kunci (menit; 0 = langsung)
# KUNCI_AKUN_TUNDA_MENIT=
# Wajib daftar / login di website
# WEB_LOGIN_WAJIB=
# Panggilan WEARTA CHAT — alamat server TURN (opsional)
# TURN_URL=
# Panggilan WEARTA CHAT — username TURN
# TURN_USERNAME=
# Panggilan WEARTA CHAT — password TURN (rahasia)
# TURN_CREDENTIAL=
# Saldo Kaget (bagi saldo ke teman lewat tautan)
# KAGET_AKTIF=
# Saldo Kaget — total minimal per paket (Rp)
# KAGET_MIN_TOTAL=
# Saldo Kaget — total maksimal per paket (Rp)
# KAGET_MAKS_TOTAL=
# Saldo Kaget — bagian minimal tiap penerima (Rp)
# KAGET_MIN_PER_ORANG=
# Saldo Kaget — jumlah penerima maksimal per paket
# KAGET_MAKS_PENERIMA=
# Saldo Kaget — masa berlaku paket (jam)
# KAGET_MASA_JAM=
# Saldo Kaget — paket aktif maksimal per pembuat
# KAGET_MAKS_AKTIF=
# Saldo Kaget — biaya admin dari total paket (%)
# KAGET_BIAYA_PERSEN=
# Saldo Kaget — akun baru boleh membuat/mengklaim setelah (jam sejak daftar)
# KAGET_UMUR_AKUN_JAM=
# QRIS Gateway — penarikan merchant otomatis via AustinPay
# GW_WD_OTOMATIS=
# QRIS Gateway — maks penarikan per merchant per hari
# GW_WD_MAKS_HARI=
# Event musiman otomatis (diskon, cashback, banner, tema)
# MUSIM_AKTIF=
# Event musiman — batas atas diskon harga nokos (%)
# MUSIM_DISKON_MAKS=
# Keamanan WD — matikan WD otomatis bila masalah penyedia ≥ (kali per 10 menit)
# WD_PEMUTUS_MAKS=
# Keamanan WD — maks akun berbeda yang boleh menarik ke nomor e-wallet yang sama
# WD_AKUN_PER_NOMOR=
# Keamanan WD — akun baru boleh menarik setelah (jam sejak daftar)
# WD_UMUR_AKUN_JAM=
# Keamanan WD — kabari admin bila satu penarikan ≥ (Rp)
# WD_ALERT_RP=
# Ban akun: IP-nya ikut diblokir dari seluruh situs
# BLOKIR_IP_SAAT_BAN=
# WEARTA CHAT: hapus otomatis pesan berisi kata terlarang
# WA_FILTER_AKTIF=
# WEARTA CHAT: daftar kata terlarang (pisah koma)
# WA_KATA_TERLARANG=

# 📧 Stor Gmail (freelance)  
# Tarik saldo Stor — maks total per akun per hari (Rp)
# WD_SETOR_MAKS_RP_HARI=
# SetoranGmail — API key (rahasia)
# SETORGMAIL_APIKEY=
# SetoranGmail — alamat API
# SETORGMAIL_BASE_URL=
# Stor Gmail: buka untuk pengguna
# SETORGMAIL_AKTIF=
# Bot setor alternatif (tujuan tombol saat semua room web tutup)
# SETORGMAIL_BOT_URL=
# Teks popup 'web tutup → pakai bot'
# SETORGMAIL_BOT_TEKS=
# Untung Anda per email (Rp) — dipotong dari harga room
# SETORGMAIL_UNTUNG_RP=
# Stor Gmail — maks email per sekali generate
# SETORGMAIL_MAKS_GENERATE=
# Stor Gmail — maks email di-generate per akun per hari
# SETORGMAIL_MAKS_HARI=
# Stor Gmail — maks email belum disetor per akun
# SETORGMAIL_MAKS_MENUNGGU=
# SetoranGmail — bank/e-wallet pemilik (dikirim ke penyedia)
# SETORGMAIL_BANK=
# SetoranGmail — nomor rekening/e-wallet pemilik
# SETORGMAIL_REKENING=
# Kredit upah otomatis bila penyedia menyatakan setoran diterima
# SETORGMAIL_KREDIT_OTOMATIS=
# Status penyedia yang dianggap DITERIMA (pisah koma)
# SETORGMAIL_STATUS_OK=
# Status penyedia yang dianggap DITOLAK (pisah koma)
# SETORGMAIL_STATUS_TOLAK=
# Tarik saldo Stor ke e-wallet (otomatis via AustinPay)
# WD_SETOR_AKTIF=
# Tarik saldo Stor — minimal diterima (Rp)
# WD_SETOR_MIN_RP=
# Tarik saldo Stor — biaya admin per penarikan (Rp)
# WD_SETOR_FEE_RP=
# Tarik saldo Stor — maks penarikan per akun per hari
# WD_SETOR_MAKS_HARI=
# Tarik saldo Stor — maks per penarikan (Rp)
# WD_SETOR_MAKS_RP=

# 🏪 Reseller & kreator  
# Slot bot tambahan — harga per slot (Rp)
# RESELLER_SLOT_HARGA=
# Slot bot tambahan — maksimal yang boleh dibeli
# RESELLER_SLOT_MAKS=
# Paket Premium reseller — harga (Rp)
# RESELLER_PREMIUM_HARGA=
# Paket Premium — masa berlaku (hari)
# RESELLER_PREMIUM_HARI=
# Paket Premium — tambahan slot bot
# RESELLER_PREMIUM_SLOT=
# Paket Premium — batas markup (%)
# RESELLER_PREMIUM_MARKUP_MAKS=
# Paket Premium — tambahan potongan grosir (%)
# RESELLER_PREMIUM_DISKON=
# Level reseller (omzet bulanan : potongan grosir % : bonus target Rp)
# RESELLER_TIER=
# Program kreator — komisi bawaan (% dari untung toko)
# AFILIASI_PERSEN=

# ⚙️ Lainnya  
# Rich Message Telegram (1 = nyala, 0 = mati)
# RICH_MESSAGE=
# Push web — kunci publik VAPID
# VAPID_PUBLIC_KEY=
# Push web — kunci privat VAPID (rahasia)
# VAPID_PRIVATE_KEY=
# Push web — kontak (mailto: atau https://)
# VAPID_SUBJECT=
# Jaminan OTP — biaya (% dari harga nomor)
# JAMINAN_PERSEN=
# Jaminan OTP — tunggu berapa menit sebelum ganti
# JAMINAN_MENIT=
# Tombol di dalam pesan (1 = di dalam, 0 = di bawah pesan)
# RICH_TOMBOL_DALAM=
# Bonus undang teman — minimal deposit teman (Rp)
# REFERRAL_MIN_DEPOSIT=
# Bonus undang teman — maksimal per teman (Rp)
# REFERRAL_MAKS_BONUS=
# Bonus undang teman — maksimal per pengundang per 24 jam
# REFERRAL_MAKS_HARIAN=
# Bonus undang teman (% dari deposit pertama)
# REFERRAL_BONUS_PERCENT=
# Referral berjenjang — bonus level 2 (% dari bonus level 1)
# REFERRAL_L2_PERSEN=

# ── Batas deposit & lain-lain (opsional, ada nilai bawaan) ──
# DEPOSIT_MIN_AMOUNT=2000
# DEPOSIT_MAX_AMOUNT=1000000
# OTP_MARKUP_PERCENT=0

