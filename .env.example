# MongoDB Atlas connection string (buat cluster gratis di https://www.mongodb.com/cloud/atlas)
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/artapedia

# Pakasir (https://pakasir.com) - untuk deposit otomatis QRIS
PAKASIR_PROJECT=slug-project-kamu
PAKASIR_APIKEY=api-key-pakasir-kamu

# RumahOTP (https://www.rumahotp.io) - untuk beli nomor OTP semua layanan
RUMAHOTP_APIKEY=rk-xxxxxxxxxxxxxxxxxxxxxxxx

# Batas nominal deposit (rupiah)
DEPOSIT_MIN_AMOUNT=2000
DEPOSIT_MAX_AMOUNT=1000000

# Markup harga OTP dalam persen, contoh 10 = harga RumahOTP + 10%. Boleh 0.
OTP_MARKUP_PERCENT=0

# Notifikasi Telegram (opsional) - dikirim ke channel/grup saat ada deposit pending,
# deposit sukses, dan pembelian nomor OTP/nokos. Kalau dua variabel di bawah
# dikosongkan, notifikasi otomatis nonaktif tanpa mengganggu transaksi.
# 1. Buat bot via @BotFather, ambil token-nya.
# 2. Tambahkan bot itu jadi admin di channel/grup tujuan.
# 3. Ambil chat_id channel (angka negatif untuk channel/grup, atau @username_channel kalau publik).
TELEGRAM_BOT_TOKEN=123456789:isi-token-bot-kamu
TELEGRAM_CHAT_ID=@nama_channel_kamu
# Link ads yang ditempel di setiap notifikasi ("mau beli nokos kuy")
TELEGRAM_ADS_LINK=https://t.me/isi_link_kamu_disini
TELEGRAM_ADS_TEXT=Mau beli nokos kuy? klik di sini
